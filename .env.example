# Set these with export in your shell. No dotenv loader is required.
HMC_WORKSPACE=/path/to/human_model_comparison/workspace
NUSCENES_ROOT=/path/to/nuScenes
CONDA_ROOT=/path/to/miniconda3
HMC_ENV_ROOT=/path/to/system-disk/conda_envs
HMC_WEIGHT_ROOT=/path/to/system-disk/model_weights/human_comparison
HMC_MODEL_CACHE=/path/to/system-disk/model_weights
DRIVESTUDIO_ROOT=/path/to/drivestudio
SPLATAD_ROOT=/path/to/splatad
HMC_THIRD_PARTY=/path/to/third_party

